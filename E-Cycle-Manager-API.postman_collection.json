{
  "info": {
    "name": "EcoRide+ Manager API",
    "description": "Complete API collection for EcoRide+ Manager operations - Cycles, Stations, and Issues",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
