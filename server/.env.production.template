# Production Environment Variables Template
# Copy this file to .env.production and fill in your values

# Server Configuration
NODE_ENV=production
PORT=3000

# MongoDB Configuration
# Get this from MongoDB Atlas after creating your cluster
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/cycles?retryWrites=true&w=majority

# JWT Configuration
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Client URL (your frontend URL on Vercel)
CLIENT_URL=https://your-frontend.vercel.app

# Server URL (your backend URL on a persistent Node host)
SERVER_URL=https://your-backend-host.com

# Email Configuration
# IMPORTANT: Enable 2-Step Verification on Gmail first
# Then generate App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ecyclecutm@gmail.com
SMTP_PASS=your_16_character_gmail_app_password_no_spaces
SMTP_FROM=ecyclecutm@gmail.com

# Stripe Configuration (Optional)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
