# =============================================
# E-Cycle Server Environment Variables
# Copy this file to server/.env and fill in values
# NEVER commit .env to version control
# =============================================

# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/ecycle
# Production: MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/ecycle

# JWT
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Email / OTP (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=E-Cycle <your-email@gmail.com>

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
# Production: CLIENT_URL=https://your-app.vercel.app

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Redis (optional — for session/caching)
# REDIS_URL=redis://localhost:6379

# AI Service (if running locally)
AI_SERVICE_URL=http://localhost:8000

# Admin email for manager approval notifications
ADMIN_EMAIL=deepikanuti@gmail.com
